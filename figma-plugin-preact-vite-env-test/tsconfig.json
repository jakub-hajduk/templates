{
	"compilerOptions": {
		"target": "es6",
		"lib": ["es6", "DOM"],
		"strict": true,
		"types": ["@figma/plugin-typings"],
		"moduleResolution": "Bundler",
		"module": "ESNext",
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
	},
	"include": ["./src/**/*", "./module.d.ts", "./figstack.config.ts"]
}
